# ------------------------------------------------------------------
# TaskFlow backend environment
# Copy to .env for local (non-Docker) development. Never commit .env.
# ------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# TCP port the HTTP server listens on
PORT=3000

# Interface to bind. Keep 0.0.0.0 so the process is reachable inside containers.
HOST=0.0.0.0

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=taskflow
DATABASE_USER=taskflow
DATABASE_PASSWORD=change-me
# Max connections held by the pg connection pool
DATABASE_POOL_MAX=10

# --- Authentication ---
# Secret used to sign JWTs. Required in production; use a long random value.
JWT_SECRET=change-me
# Token lifetime (jsonwebtoken format: 15m, 1h, 1d, ...)
JWT_EXPIRATION=1d

# --- HTTP ---
# Comma-separated list of allowed CORS origins, or * for any origin
CORS_ORIGIN=*
# Max accepted JSON request body size
BODY_LIMIT=100kb

# --- Observability ---
# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Service name attached to logs, traces and metrics
OTEL_SERVICE_NAME=taskflow-backend
# OTLP/HTTP endpoint of an OpenTelemetry Collector (e.g. http://otel-collector:4318).
# Leave EMPTY to disable tracing — the app runs fine without a collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Trace exporter: otlp | none. Defaults to otlp when an endpoint is set, none otherwise.
OTEL_TRACES_EXPORTER=

# --- Operations ---
# Expose /debug/* endpoints (error/latency/cpu/memory generators). NEVER true in prod.
ENABLE_DEBUG_ENDPOINTS=false
# How long graceful shutdown waits for in-flight requests before forcing exit (ms)
SHUTDOWN_TIMEOUT_MS=10000
