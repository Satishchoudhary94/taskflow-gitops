# ------------------------------------------------------------------
# TaskFlow — root environment file (used by docker-compose.yml)
# Copy to .env and adjust. Never commit a real .env file.
# ------------------------------------------------------------------

# --- PostgreSQL container ---
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me

# --- Backend ---
# Secret used to sign JWT access tokens. MUST be long and random in production.
JWT_SECRET=change-me
# How long an access token stays valid (e.g. 15m, 1h, 1d)
JWT_EXPIRATION=1d
# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Enable /debug/* endpoints (error/latency/cpu/memory generators). Keep false by default.
ENABLE_DEBUG_ENDPOINTS=false
# OTLP endpoint of an OpenTelemetry Collector. Leave empty to disable tracing entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Frontend ---
# URL the user's BROWSER uses to reach the backend API.
API_URL=http://localhost:3000
